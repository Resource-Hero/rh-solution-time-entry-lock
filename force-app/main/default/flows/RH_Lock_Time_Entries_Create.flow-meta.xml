<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <constants>
        <description>Which lock rule applies. One of: Days, Week, Month.</description>
        <name>LockMode</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Week</stringValue>
        </value>
    </constants>
    <constants>
        <description>Only used when LockMode = Days. Entries older than this many days are locked.</description>
        <name>LockDays</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>7.0</numberValue>
        </value>
    </constants>
    <customErrors>
        <name>Error_Older_Than_N_Days</name>
        <label>Locked: Older than N days</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Locked: the entry dated {!$Record.ResourceHeroApp__ForecastDate__c} is more than {!LockDays} days old. You can no longer log hours against it. Contact your administrator if it needs correcting.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Error_Before_This_Week</name>
        <label>Locked: Before this week</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Locked: the entry dated {!$Record.ResourceHeroApp__ForecastDate__c} is before this week ({!Cutoff_This_Week}). You can no longer log hours against it. Contact your administrator if it needs correcting.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <customErrors>
        <name>Error_Before_This_Month</name>
        <label>Locked: Before this month</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Locked: the entry dated {!$Record.ResourceHeroApp__ForecastDate__c} is before this month ({!Cutoff_This_Month}). You can no longer log hours against it. Contact your administrator if it needs correcting.</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>Can_User_Bypass_Lock</name>
        <label>Can this user edit locked entries?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Yes - has bypass permission</defaultConnectorLabel>
        <rules>
            <name>No_Bypass</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Edit_Locked_Time_Entries</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Which_Lock_Rule_Applies</targetReference>
            </connector>
            <label>No - enforce lock</label>
        </rules>
    </decisions>
    <decisions>
        <name>Which_Lock_Rule_Applies</name>
        <label>Which lock rule applies?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not locked</defaultConnectorLabel>
        <rules>
            <name>Older_Than_N_Days</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LockMode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Days</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ResourceHeroApp__ForecastDate__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Cutoff_Rolling_Days</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Older_Than_N_Days</targetReference>
            </connector>
            <label>Older than N days</label>
        </rules>
        <rules>
            <name>Before_This_Week</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LockMode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Week</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ResourceHeroApp__ForecastDate__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Cutoff_This_Week</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Before_This_Week</targetReference>
            </connector>
            <label>Before this week</label>
        </rules>
        <rules>
            <name>Before_This_Month</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LockMode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Month</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ResourceHeroApp__ForecastDate__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Cutoff_This_Month</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Error_Before_This_Month</targetReference>
            </connector>
            <label>Before this month</label>
        </rules>
    </decisions>
    <description>Blocks users without the Edit Locked Time Entries custom permission from making changes to Resource Hero time entries older than the configured cutoff. Change the LockMode constant (Days / Week / Month) and LockDays to tune the rule.</description>
    <environments>Default</environments>
    <formulas>
        <description>Rolling window: today minus LockDays.</description>
        <name>Cutoff_Rolling_Days</name>
        <dataType>Date</dataType>
        <expression>TODAY() - {!LockDays}</expression>
    </formulas>
    <formulas>
        <description>Monday of the current week (matches Resource Hero's Week Beginning field).</description>
        <name>Cutoff_This_Week</name>
        <dataType>Date</dataType>
        <expression>TODAY() - MOD(TODAY() - DATE(1900, 1, 8), 7)</expression>
    </formulas>
    <formulas>
        <description>First day of the current month.</description>
        <name>Cutoff_This_Month</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(TODAY()), MONTH(TODAY()), 1)</expression>
    </formulas>
    <interviewLabel>RH Lock Time Entries - Create {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RH Lock Time Entries - Create</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Can_User_Bypass_Lock</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Is_Standard_Assignment__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>ResourceHeroApp__Actual__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>ResourceHeroApp__Actual__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </filters>
        <object>ResourceHeroApp__Resource_Forecast__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
